# Required
ANTHROPIC_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional — models
# GAIO_MODEL=claude-opus-5-5             # one-off onboarding: profile, topics, prompts
# GAIO_ANALYSIS_MODEL=claude-haiku-4-5   # daily scoring of every answer
# GAIO_ANALYSIS_EFFORT=low               # ignored on Haiku

# Optional — defaults applied to newly onboarded brands
# GAIO_ENGINES=chatgpt,gemini,perplexity,google_ai_overview,google_ai_mode   # add ",claude" to include Claude (~$0.10/answer)
# GAIO_COUNTRY=us
# GAIO_LANGUAGE=en

# Optional — DataForSEO throughput (their limit is 30 simultaneous requests per account)
# DATAFORSEO_CONCURRENCY=25
# DATAFORSEO_QUEUE=1        # 0 = run ChatGPT/Gemini in Live mode (faster, ~3x the price)
# GAIO_PROMPT_CONCURRENCY=4
# Optional — pin the models DataForSEO uses for Claude / Perplexity (default: auto-pick)
# DATAFORSEO_CLAUDE_MODEL=
# DATAFORSEO_PERPLEXITY_MODEL=sonar-pro

# Optional — storage (default ./data/gaio.db inside the GAIO install)
# GAIO_DB=/absolute/path/gaio.db

# Optional — REST API / dashboard (`gaio serve`)
# GAIO_API_TOKEN=change-me
# PORT=8787

# Optional — daily email via Resend
# RESEND_API_KEY=
# GAIO_EMAIL_FROM=GAIO <reports@yourdomain.com>
# GAIO_EMAIL_TO=you@yourdomain.com
