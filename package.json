{
  "name": "gaio",
  "version": "0.1.0",
  "description": "Self-hosted AIO/GEO monitoring engine that tracks your brand positioning across ChatGPT, Gemini, Perplexity, Claude and Google AI.",
  "type": "module",
  "bin": {
    "gaio": "dist/cli.js"
  },
  "scripts": {
